# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Storage (SQLite is fine locally; Docker Compose uses PostgreSQL)
DATABASE_URL=sqlite:///./relay.db
# DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379/0

# Stripe: whsec_... from `stripe listen` or the Dashboard; sk_test_... for reconciliation
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_API_KEY=
SIGNATURE_TOLERANCE_SECONDS=300

# Merchant app Relay delivers to
DOWNSTREAM_URL=http://localhost:9000/events
DELIVERY_TIMEOUT_SECONDS=5

# Retries
MAX_ATTEMPTS=12
BACKOFF_BASE_SECONDS=2
BACKOFF_CAP_SECONDS=3600

# Out-of-order handling
PARENT_WAIT_SECONDS=600
PARENT_RECHECK_SECONDS=5

# Worker
WORKER_BATCH_SIZE=50
WORKER_POLL_SECONDS=1

# Reconciliation
RECONCILE_INTERVAL_SECONDS=3600
RECONCILE_DEFAULT_LOOKBACK_SECONDS=259200
RECONCILE_OVERLAP_SECONDS=300
RECONCILE_LOCK_TTL_SECONDS=600

# Admin API bearer token (empty = no auth; set it anywhere but your laptop)
ADMIN_TOKEN=
